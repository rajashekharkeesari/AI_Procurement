# Copy to .env and fill in:  cp .env.example .env

# Public IP of the EC2 instance (used by docker-compose to build the frontend API URL)
EC2_PUBLIC_IP = <your-ec2-public-ip>

Frontend_url = http://<your-ec2-public-ip>:3000
Backend_url = http://<your-ec2-public-ip>:8000
PORT = 8000

# SQLite (default). For RDS use: postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/<dbname>
DATABASE_URL = sqlite:///./procurement.db

# JWT settings. Generate the secret with: openssl rand -hex 32
algorithm = HS256
Secret_key = <generate-a-long-random-string>
expiration_time = 30

# Groq LLM
GROQ_API_KEY = <your-groq-api-key>
# GROQ_MODEL = llama-3.1-8b-instant
